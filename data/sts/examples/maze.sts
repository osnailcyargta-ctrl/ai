// STS project: maze
// stage 480x320
// Arrow keys move the block. Solid walls stop it. Reach the green pad.

@root 0 main
background("#14120d")

var menang = 0

// invisible walls keep the player on the stage
setup coll -40   0 40 320 solid. batasKiri
setup coll 480   0 40 320 solid. batasKanan
setup coll   0 -40 480 40 solid. batasAtas
setup coll   0 320 480 40 solid. batasBawah

on 20 20 draw square 24 color "#93cc5f". pemain
setup coll /id"pemain" solid. badanPemain

on 0 150 draw rect 300 18 color "#5f4530". tembok1
setup coll /id"tembok1" solid. w1

on 180 0 draw rect 18 110 color "#5f4530". tembok2
setup coll /id"tembok2" solid. w2

on 300 200 draw rect 18 120 color "#5f4530". tembok3
setup coll /id"tembok3" solid. w3

on 430 270 draw square 44 color "#4f8f2f". gawang
setup coll /id"gawang" detect(goto #1). zonaMenang

on 16 296 draw text "arrow keys" 13 color "#767d75". hint

forever:
    if key("left"):
        move("pemain", -3, 0)
    if key("right"):
        move("pemain", 3, 0)
    if key("up"):
        move("pemain", 0, -3)
    if key("down"):
        move("pemain", 0, 3)

@root 1 menang
if menang == 1:
    return
menang = 1
show.popup("kena! good job")
on 120 120 draw text "MENANG" 40 color "#b9e389". banner
