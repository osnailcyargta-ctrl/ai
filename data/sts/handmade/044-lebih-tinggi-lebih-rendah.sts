// request: game tebak kartu berikutnya lebih tinggi atau lebih rendah || higher or lower: guess if the next card is bigger
background("#3d0c02")
var kartu = 7
var benar = 0
on 200 50 draw rect 120 160 color "#fafafa". kartuGambar
on 238 100 draw text "7" 50 color "#3d0c02". angka
on 60 250 draw rect 140 44 color "#4caf50". tinggi
on 88 262 draw text "LEBIH TINGGI" 14 color "#ffffff". l1
on 320 250 draw rect 140 44 color "#f44336". rendah
on 344 262 draw text "LEBIH RENDAH" 14 color "#ffffff". l2
on 16 10 draw text "benar 0" 16 color "#ffffff". hud

def tebak(naik):
    var baru = randint(1, 13)
    var ok = (naik == 1 and baru > kartu) or (naik == 0 and baru < kartu)
    if ok:
        benar = benar + 1
    else:
        show.popup("salah! kartunya " + baru + ". streak lu " + benar)
        benar = 0
    kartu = baru
    set("angka", "text", str(kartu))
    set("hud", "text", "benar " + benar)

onclick /id"tinggi" check:
    tebak(1)
onclick /id"rendah" check:
    tebak(0)
