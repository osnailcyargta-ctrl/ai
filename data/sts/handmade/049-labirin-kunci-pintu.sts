// request: labirin ambil kunci dulu baru pintu kebuka || a maze where u need the key before the door opens
background("#1c1c1c")
var punyaKunci = 0
on 0 0 draw rect 520 10 color "#555555". t1
on 0 350 draw rect 520 10 color "#555555". t2
on 0 0 draw rect 10 360 color "#555555". t3
on 510 0 draw rect 10 360 color "#555555". t4
on 120 0 draw rect 14 260 color "#555555". t5
on 260 100 draw rect 14 260 color "#555555". t6
on 390 0 draw rect 14 240 color "#555555". t7
setup coll /id"t1" solid. c1
setup coll /id"t2" solid. c2
setup coll /id"t3" solid. c3
setup coll /id"t4" solid. c4
setup coll /id"t5" solid. c5
setup coll /id"t6" solid. c6
setup coll /id"t7" solid. c7
on 40 300 draw square 20 color "#4fc3f7". pemain
setup coll /id"pemain" solid. badan
on 320 40 draw rect 16 10 color "#ffd700". kunci
on 450 300 draw rect 30 40 color "#8b4513". pintu

forever:
    if key("left"):
        move("pemain", -3, 0)
    if key("right"):
        move("pemain", 3, 0)
    if key("up"):
        move("pemain", 0, -3)
    if key("down"):
        move("pemain", 0, 3)
    if exists("kunci") and touching("pemain", "kunci"):
        destroy("kunci")
        punyaKunci = 1
        set("pintu", "color", "#4caf50")
    if touching("pemain", "pintu"):
        if punyaKunci == 1:
            show.popup("keluar! menang")
            setpos("pemain", 40, 300)
        else:
            set("pintu", "color", "#b71c1c")
