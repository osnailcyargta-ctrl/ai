// request: konversi suhu celcius ke fahrenheit || convert celsius to fahrenheit
background("#1d1b2e")
on 16 20 draw text "konversi suhu" 24 color "#ffcf6e". judul
on 16 80 draw text "" 22 color "#ffffff". f
on 16 120 draw text "" 22 color "#ffffff". k
var c = num(show.anspopup("suhu dalam celcius?"))
set("f", "text", c + " C = " + (c * 9 / 5 + 32) + " F")
set("k", "text", c + " C = " + (c + 273.15) + " K")
if c > 35:
    show.popup("panas banget, minum air")
elif c < 0:
    show.popup("beku. pake jaket")
