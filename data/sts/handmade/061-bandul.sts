// request: simulasi bandul yang ayun ayun || a swinging pendulum simulation
background("#fafafa")
var sudut = 1
var kec = 0
on 255 20 draw circle 10 color "#424242". paku
on 260 25 draw line 260 200 color "#424242". tali
on 245 185 draw circle 30 color "#e53935". beban

forever:
    kec = kec - sin(sudut) * 0.004
    kec = kec * 0.999
    sudut = sudut + kec
    var x = 260 + sin(sudut) * 180
    var y = 25 + cos(sudut) * 180
    set("tali", "w", x)
    set("tali", "h", y)
    setpos("beban", x - 15, y - 15)
