// request: game breakout, pantulin bola buat ngancurin bata || breakout: bounce the ball to smash the bricks
background("#0a0a23")
var vx = 3
var vy = -3
var sisa = 5
on 220 330 draw rect 90 12 color "#61dafb". raket
on 255 300 draw circle 14 color "#ffffff". bola
on 30 50 draw rect 80 20 color "#ff6b6b". bata1
on 125 50 draw rect 80 20 color "#feca57". bata2
on 220 50 draw rect 80 20 color "#48dbfb". bata3
on 315 50 draw rect 80 20 color "#1dd1a1". bata4
on 410 50 draw rect 80 20 color "#ff9ff3". bata5

def cekBata(id):
    if exists(id) and touching("bola", id):
        destroy(id)
        vy = abs(vy)
        sisa = sisa - 1
        if sisa == 0:
            show.popup("semua bata ancur. menang!")

forever:
    if key("left"):
        move("raket", -7, 0)
    if key("right"):
        move("raket", 7, 0)
    move("bola", vx, vy)
    if get("bola", "x") < 0 or get("bola", "x") > 506:
        vx = 0 - vx
    if get("bola", "y") < 0:
        vy = abs(vy)
    if touching("bola", "raket"):
        vy = 0 - abs(vy)
    cekBata("bata1")
    cekBata("bata2")
    cekBata("bata3")
    cekBata("bata4")
    cekBata("bata5")
    if get("bola", "y") > 360:
        setpos("bola", 255, 300)
        vy = -3
