// request: game nyebrang jalan kayak frogger || a frogger style road crossing game
background("#2f2f2f")
var level = 1
on 0 0 draw rect 520 40 color "#3c8d2f". seberang
on 0 320 draw rect 520 40 color "#3c8d2f". awal
on 250 330 draw square 20 color "#7cfc00". kodok
on 0 80 draw rect 70 34 color "#ff5555". mobil1
on 300 150 draw rect 90 34 color "#55aaff". mobil2
on 100 220 draw rect 70 34 color "#ffaa00". mobil3
on 16 330 draw text "level 1" 14 color "#ffffff". hud

def jalan(id, v):
    move(id, v * level, 0)
    if get(id, "x") > 540:
        set(id, "x", -100)
    if get(id, "x") < -100:
        set(id, "x", 540)
    if touching("kodok", id):
        setpos("kodok", 250, 330)

forever:
    if key("up"):
        move("kodok", 0, -3)
    if key("down"):
        move("kodok", 0, 3)
    if key("left"):
        move("kodok", -3, 0)
    if key("right"):
        move("kodok", 3, 0)
    jalan("mobil1", 3)
    jalan("mobil2", -4)
    jalan("mobil3", 5)
    if get("kodok", "y") < 30:
        level = level + 1
        set("hud", "text", "level " + level)
        setpos("kodok", 250, 330)
