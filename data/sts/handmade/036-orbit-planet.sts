// request: planet muter ngelilingin matahari || planets orbiting the sun
background("#000005")
var t = 0
on 230 150 draw circle 60 color "#ffcc33". matahari
on 0 0 draw circle 14 color "#4fa3ff". bumi
on 0 0 draw circle 6 color "#cccccc". bulan
on 0 0 draw circle 20 color "#e0965a". jupiter

forever:
    t = t + 1
    var bx = 252 + cos(t * 0.02) * 110
    var by = 172 + sin(t * 0.02) * 110
    setpos("bumi", bx, by)
    setpos("bulan", bx + 4 + cos(t * 0.1) * 22, by + 4 + sin(t * 0.1) * 22)
    setpos("jupiter", 250 + cos(t * 0.008) * 170, 170 + sin(t * 0.008) * 150)
