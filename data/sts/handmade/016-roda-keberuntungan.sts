// request: roda keberuntungan yang muter terus berhenti random || a wheel of fortune that spins and stops at random
background("#13111c")
var putar = 0
var kecepatan = 0
var hadiah = "?"
on 160 60 draw circle 200 color "#3a2e5c". roda
on 255 40 draw triangle 20 24 color "#ffcc00". jarum
on 205 150 draw text "?" 30 color "#ffffff". tulisan
on 190 290 draw rect 140 40 color "#5c3aa8". tombol
on 225 300 draw text "PUTER" 18 color "#ffffff". lt

onclick /id"tombol" check:
    kecepatan = rand(15, 25)

forever:
    if kecepatan > 0.2:
        putar = putar + kecepatan
        kecepatan = kecepatan * 0.97
        set("roda", "rot", putar)
        set("tulisan", "text", choose("100", "zonk", "500", "1000", "zonk", "50"))
    elif kecepatan > 0:
        kecepatan = 0
        show.popup("lu dapet: " + get("tulisan", "text"))
