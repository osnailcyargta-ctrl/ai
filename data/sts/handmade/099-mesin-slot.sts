// request: mesin slot 3 gambar, menang kalo sama semua || a 3 reel slot machine, win when all match
background("#4a148c")
var koin = 10
on 60 80 draw square 110 color "#ffffff". r1
on 205 80 draw square 110 color "#ffffff". r2
on 350 80 draw square 110 color "#ffffff". r3
on 95 115 draw text "?" 40 color "#4a148c". s1
on 240 115 draw text "?" 40 color "#4a148c". s2
on 385 115 draw text "?" 40 color "#4a148c". s3
on 190 240 draw rect 140 44 color "#ff6f00". tarik
on 230 252 draw text "TARIK" 18 color "#ffffff". lt
on 16 10 draw text "koin 10" 18 color "#ffd54f". hud

def simbol():
    return choose("7", "$", "@", "#")

onclick /id"tarik" check:
    if koin <= 0:
        show.popup("koin abis. bangkrut 🥀")
        koin = 10
    else:
        koin = koin - 1
        var a = simbol()
        var b = simbol()
        var c = simbol()
        set("s1", "text", a)
        set("s2", "text", b)
        set("s3", "text", c)
        if a == b and b == c:
            koin = koin + 15
            show.popup("JACKPOT +15")
        elif a == b or b == c or a == c:
            koin = koin + 2
    set("hud", "text", "koin " + koin)
