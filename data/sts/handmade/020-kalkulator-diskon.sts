// request: kalkulator diskon belanja || a shopping discount calculator
background("#1b1b2f")
on 16 20 draw text "kalkulator diskon" 24 color "#e43f5a". judul
on 16 90 draw text "" 20 color "#ffffff". h1
on 16 125 draw text "" 20 color "#ffffff". h2
on 16 160 draw text "" 24 color "#7cfc00". h3
var harga = num(show.anspopup("harga barang?"))
var diskon = num(show.anspopup("diskon berapa persen?"))
var potong = harga * diskon / 100
set("h1", "text", "harga: " + harga)
set("h2", "text", "hemat: " + potong)
set("h3", "text", "bayar: " + (harga - potong))
