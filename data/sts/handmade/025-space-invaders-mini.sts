// request: space invaders mini, tembak alien yang gerak kiri kanan || mini space invaders: shoot the aliens moving side to side
background("#000010")
var arah = 2
var tembak = 0
var skor = 0
on 240 320 draw triangle 30 20 color "#00ff66". kapal
on -20 -20 draw rect 4 12 color "#ffff00". laser
on 60 60 draw square 26 color "#ff3366". alien1
on 140 60 draw square 26 color "#ff3366". alien2
on 220 60 draw square 26 color "#ff3366". alien3
on 300 60 draw square 26 color "#ff3366". alien4
on 16 10 draw text "skor 0" 16 color "#ffffff". hud

def kena(id):
    if exists(id) and touching("laser", id):
        destroy(id)
        tembak = 0
        setpos("laser", -20, -20)
        skor = skor + 10
        set("hud", "text", "skor " + skor)

forever:
    if key("left"):
        move("kapal", -5, 0)
    if key("right"):
        move("kapal", 5, 0)
    if key("space") and tembak == 0:
        tembak = 1
        setpos("laser", get("kapal", "x") + 13, 300)
    if tembak == 1:
        move("laser", 0, -9)
        if get("laser", "y") < 0:
            tembak = 0
    move("alien1", arah, 0)
    move("alien2", arah, 0)
    move("alien3", arah, 0)
    move("alien4", arah, 0)
    if get("alien1", "x") < 10 or get("alien1", "x") > 200:
        arah = 0 - arah
    kena("alien1")
    kena("alien2")
    kena("alien3")
    kena("alien4")
