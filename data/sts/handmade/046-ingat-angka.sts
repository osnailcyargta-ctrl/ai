// request: game ngingetin angka yang muncul sebentar || a memory game: remember the number shown for a moment
background("#1b1b1b")
var level = 3
var angka = 0
on 160 120 draw text "" 50 color "#00e5ff". layar
on 16 10 draw text "level 3" 16 color "#ffffff". hud
var main = 1
while main == 1:
    angka = randint(pow(10, level - 1), pow(10, level) - 1)
    set("layar", "text", str(angka))
    wait 2
    set("layar", "text", "?")
    var jawab = num(show.anspopup("angka tadi berapa?"))
    if jawab == angka:
        level = level + 1
        set("hud", "text", "level " + level)
    else:
        show.popup("salah, tadi " + angka + ". level lu " + level)
        main = 0
