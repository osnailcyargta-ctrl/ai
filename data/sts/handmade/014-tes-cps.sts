// request: tes klik per detik selama 10 detik || a clicks per second test for 10 seconds
background("#0d1b2a")
var klik = 0
var selesai = 0
on 16 10 draw text "klik bulatannya sebanyak mungkin" 16 color "#e0e1dd". info
on 185 90 draw circle 150 color "#415a77". tombol
on 200 280 draw text "klik: 0" 22 color "#ffffff". hud
on 380 10 draw text "10" 22 color "#ffd166". sisa

def habis():
    selesai = 1
    show.popup("waktu habis! " + klik + " klik = " + (klik / 10) + " klik per detik")

countdown 10 (habis()). batas

onclick /id"tombol" check:
    if selesai == 0:
        klik = klik + 1
        set("hud", "text", "klik: " + klik)
        set("tombol", "color", choose("#415a77", "#778da9", "#1b263b"))

forever:
    set("sisa", "text", str(ceil(/time"batas")))
