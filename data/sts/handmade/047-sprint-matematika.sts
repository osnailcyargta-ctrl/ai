// request: sprint matematika 30 detik, jawab sebanyak mungkin || a 30 second maths sprint
background("#0f2027")
var benar = 0
var selesai = 0
on 16 10 draw text "benar 0" 18 color "#ffffff". hud
on 380 10 draw text "30" 18 color "#ffd166". sisa
countdown 30 (selesai = 1). batas
while selesai == 0:
    var a = randint(2, 12)
    var b = randint(2, 12)
    var j = num(show.anspopup(a + " x " + b + " = ?"))
    if j == a * b and selesai == 0:
        benar = benar + 1
        set("hud", "text", "benar " + benar)
    set("sisa", "text", str(ceil(/time"batas")))
show.popup("waktu habis. bener " + benar + " soal")
