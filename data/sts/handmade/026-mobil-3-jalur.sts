// request: game mobil pindah 3 jalur hindarin mobil lain || a car game: switch between 3 lanes to avoid traffic
background("#333333")
var jalur = 1
var jeda = 0
var skor = 0
on 170 0 draw rect 4 360 color "#ffffff". garis1
on 340 0 draw rect 4 360 color "#ffffff". garis2
on 235 290 draw rect 50 60 color "#00aaff". mobil
on 65 -80 draw rect 50 60 color "#ff4444". lawan1
on 405 -260 draw rect 50 60 color "#ffaa00". lawan2
on 16 10 draw text "skor 0" 16 color "#ffffff". hud

def xJalur(j):
    return 65 + j * 170

def turun(id):
    move(id, 0, 6 + skor / 10)
    if get(id, "y") > 360:
        setpos(id, xJalur(randint(0, 2)), randint(-300, -80))
        skor = skor + 1
        set("hud", "text", "skor " + skor)
    if touching("mobil", id):
        show.popup("tabrakan! skor " + skor)
        skor = 0
        setpos(id, xJalur(randint(0, 2)), -200)

forever:
    jeda = jeda - 1
    if key("left") and jeda <= 0 and jalur > 0:
        jalur = jalur - 1
        jeda = 10
    if key("right") and jeda <= 0 and jalur < 2:
        jalur = jalur + 1
        jeda = 10
    set("mobil", "x", xJalur(jalur))
    turun("lawan1")
    turun("lawan2")
