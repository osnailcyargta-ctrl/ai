// request: aplikasi gambar, ngecat pake mouse || a paint app, draw with the mouse
background("#ffffff")
var warna = "#222222"
var n = 0
on 0 0 draw rect 520 34 color "#eeeeee". bar
on 8 6 draw square 22 color "#222222". cHitam
on 38 6 draw square 22 color "#e63946". cMerah
on 68 6 draw square 22 color "#2a9d8f". cHijau
on 98 6 draw square 22 color "#457b9d". cBiru
on 130 10 draw text "tahan klik buat ngecat" 13 color "#666666". info
on -10 -10 draw circle 10 color "#222222". kuas

onclick /id"cHitam" check:
    warna = "#222222"
onclick /id"cMerah" check:
    warna = "#e63946"
onclick /id"cHijau" check:
    warna = "#2a9d8f"
onclick /id"cBiru" check:
    warna = "#457b9d"

forever:
    setpos("kuas", mousex() - 5, mousey() - 5)
    set("kuas", "color", warna)
    if mousedown() and mousey() > 40:
        n = n + 1
        if n % 2 == 0:
            on {mousex() - 5} {mousey() - 5} draw circle 10 color warna. titikA
        else:
            on {mousex() - 5} {mousey() - 5} draw circle 10 color warna. titikB
