// request: papan skor buat 2 tim || a scoreboard for two teams
background("#101418")
var merah = 0
var biru = 0
on 60 40 draw text "TIM MERAH" 20 color "#ff5c5c". judulMerah
on 320 40 draw text "TIM BIRU" 20 color "#5c9dff". judulBiru
on 90 90 draw text "0" 80 color "#ffffff". angkaMerah
on 350 90 draw text "0" 80 color "#ffffff". angkaBiru
on 60 220 draw rect 140 44 color "#a83232". tambahMerah
on 105 232 draw text "+1" 20 color "#ffffff". lt1
on 320 220 draw rect 140 44 color "#3260a8". tambahBiru
on 365 232 draw text "+1" 20 color "#ffffff". lt2
on 200 300 draw rect 120 36 color "#444444". reset
on 228 309 draw text "reset" 16 color "#ffffff". lt3

onclick /id"tambahMerah" check:
    merah = merah + 1
    set("angkaMerah", "text", str(merah))

onclick /id"tambahBiru" check:
    biru = biru + 1
    set("angkaBiru", "text", str(biru))

onclick /id"reset" check:
    merah = 0
    biru = 0
    set("angkaMerah", "text", "0")
    set("angkaBiru", "text", "0")
