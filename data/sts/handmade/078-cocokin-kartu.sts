// request: game memori cocokin 4 kartu || a memory game: match 4 cards
background("#311b92")
var buka = 0
var pilihan = 0
var pasang = 0
var w1 = "#ff5252"
var w2 = "#69f0ae"
var w3 = "#ff5252"
var w4 = "#69f0ae"
if chance(0.5):
    w2 = "#ff5252"
    w3 = "#69f0ae"
on 16 10 draw text "cari 2 pasang" 16 color "#ffffff". hud

def warnaKartu(n):
    if n == 1:
        return w1
    if n == 2:
        return w2
    if n == 3:
        return w3
    return w4

def balik(n):
    set("kartu" + n, "color", warnaKartu(n))
    if buka == 0:
        buka = 1
        pilihan = n
    else:
        buka = 0
        if n != pilihan and warnaKartu(n) == warnaKartu(pilihan):
            pasang = pasang + 1
            if pasang == 2:
                show.popup("semua pasangan ketemu!")
        else:
            show.popup("bukan pasangan")
            set("kartu" + n, "color", "#9575cd")
            set("kartu" + pilihan, "color", "#9575cd")

on 60 120 draw rect 90 120 color "#9575cd". kartu1
on 170 120 draw rect 90 120 color "#9575cd". kartu2
on 280 120 draw rect 90 120 color "#9575cd". kartu3
on 390 120 draw rect 90 120 color "#9575cd". kartu4
onclick /id"kartu1" check:
    balik(1)
onclick /id"kartu2" check:
    balik(2)
onclick /id"kartu3" check:
    balik(3)
onclick /id"kartu4" check:
    balik(4)
