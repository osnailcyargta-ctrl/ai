// request: voting 3 pilihan pake tombol || a 3 option vote with buttons
background("#1a1a2e")
var a = 0
var b = 0
var c = 0
on 16 10 draw text "makanan terbaik?" 22 color "#e94560". judul
on 30 60 draw rect 140 40 color "#0f3460". pa
on 50 72 draw text "nasi goreng" 15 color "#ffffff". la
on 190 60 draw rect 140 40 color "#0f3460". pb
on 225 72 draw text "bakso" 15 color "#ffffff". lb
on 350 60 draw rect 140 40 color "#0f3460". pc
on 385 72 draw text "seblak" 15 color "#ffffff". lc
on 30 140 draw rect 10 20 color "#e94560". barA
on 30 180 draw rect 10 20 color "#f5a623". barB
on 30 220 draw rect 10 20 color "#4cd137". barC

def gambar():
    set("barA", "w", 10 + a * 20)
    set("barB", "w", 10 + b * 20)
    set("barC", "w", 10 + c * 20)

onclick /id"pa" check:
    a = a + 1
    gambar()
onclick /id"pb" check:
    b = b + 1
    gambar()
onclick /id"pc" check:
    c = c + 1
    gambar()
