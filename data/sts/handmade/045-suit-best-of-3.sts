// request: suit batu gunting kertas best of 3 || rock paper scissors, best of 3
background("#222222")
var lu = 0
var kom = 0
on 16 10 draw text "best of 3" 22 color "#ffffff". judul
on 16 50 draw text "lu 0 - 0 komputer" 18 color "#ffcc00". hud
var ronde = 0
while lu < 2 and kom < 2:
    var p = num(show.anspopup("1 batu, 2 gunting, 3 kertas"))
    var k = randint(1, 3)
    if (p == 1 and k == 2) or (p == 2 and k == 3) or (p == 3 and k == 1):
        lu = lu + 1
        show.popup("menang ronde ini")
    elif p == k:
        show.popup("seri")
    else:
        kom = kom + 1
        show.popup("kalah ronde ini")
    set("hud", "text", "lu " + lu + " - " + kom + " komputer")
if lu == 2:
    show.popup("lu juara!")
else:
    show.popup("komputer juara. coba lagi")
