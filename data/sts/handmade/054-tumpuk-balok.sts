// request: game tumpuk balok, klik buat berhentiin balok yang gerak || a stacking game: click to stop the moving block
background("#263238")
var arah = 4
var tinggi = 0
var lebar = 160
on 180 330 draw rect 160 24 color "#90a4ae". dasar
on 0 300 draw rect 160 24 color "#ff7043". balok
on 16 10 draw text "tinggi 0" 16 color "#ffffff". hud

onclick /id"balok" check:
    tinggi = tinggi + 1
    set("hud", "text", "tinggi " + tinggi)
    var y = 300 - tinggi * 24
    if y < 40:
        show.popup("nyampe atas! tinggi " + tinggi)
        tinggi = 0
        y = 300
    on {get("balok", "x")} {y + 24} draw rect {lebar} 24 color "#78909c". jejak
    set("balok", "y", y)
    arah = arah * 1.08

forever:
    move("balok", arah, 0)
    if get("balok", "x") < 0 or get("balok", "x") > 520 - lebar:
        arah = 0 - arah
