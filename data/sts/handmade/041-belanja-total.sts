// request: hitung total belanja 3 barang || add up a 3 item shopping list
background("#f1faee")
on 16 20 draw text "kasir sybau" 24 color "#1d3557". judul
on 16 80 draw text "" 18 color "#1d3557". r1
on 16 110 draw text "" 18 color "#1d3557". r2
on 16 140 draw text "" 18 color "#1d3557". r3
on 16 190 draw text "" 24 color "#e63946". total
var a = num(show.anspopup("harga barang 1?"))
var b = num(show.anspopup("harga barang 2?"))
var c = num(show.anspopup("harga barang 3?"))
set("r1", "text", "barang 1: " + a)
set("r2", "text", "barang 2: " + b)
set("r3", "text", "barang 3: " + c)
var t = a + b + c
if t > 100000:
    t = t * 0.9
    set("total", "text", "total (diskon 10%): " + t)
else:
    set("total", "text", "total: " + t)
