// request: lawan bos yang punya darah, tembak sampe mati || a boss fight: shoot the boss until its health runs out
background("#1b0000")
var darah = 30
var arah = 3
var tembak = 0
var nyawa = 3
on 200 40 draw rect 120 70 color "#b71c1c". bos
on 60 20 draw rect 400 10 color "#ff5252". barDarah
on 240 310 draw triangle 30 26 color "#00e5ff". kapal
on -20 -20 draw rect 4 12 color "#ffff00". laser
on -20 -20 draw circle 14 color "#ff9100". bola
on 16 330 draw text "nyawa 3" 14 color "#ffffff". hud

forever:
    move("bos", arah, 0)
    if get("bos", "x") < 0 or get("bos", "x") > 400:
        arah = 0 - arah
    if get("bola", "y") < 0 or get("bola", "y") > 360:
        setpos("bola", get("bos", "x") + 55, 110)
    move("bola", 0, 5)
    if key("left"):
        move("kapal", -5, 0)
    if key("right"):
        move("kapal", 5, 0)
    if key("space") and tembak == 0:
        tembak = 1
        setpos("laser", get("kapal", "x") + 13, 290)
    if tembak == 1:
        move("laser", 0, -10)
        if get("laser", "y") < 0:
            tembak = 0
    if touching("laser", "bos"):
        tembak = 0
        setpos("laser", -20, -20)
        darah = darah - 1
        set("barDarah", "w", darah * 400 / 30)
        if darah <= 0:
            show.popup("bos kalah! lu menang")
            darah = 30
            set("barDarah", "w", 400)
    if touching("kapal", "bola"):
        nyawa = nyawa - 1
        setpos("bola", get("bos", "x") + 55, 110)
        set("hud", "text", "nyawa " + nyawa)
        if nyawa <= 0:
            show.popup("lu kalah sama bos")
            nyawa = 3
