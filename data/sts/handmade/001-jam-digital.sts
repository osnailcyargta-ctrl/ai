// request: bikin jam digital yang jalan || make a digital clock that ticks
background("#0b1020")
var detik = 0
var menit = 0
var jam = 0
on 150 120 draw text "00:00:00" 48 color "#7cf0ff". layar
on 170 190 draw text "jam sybau" 16 color "#56607a". label

def dua(n):
    if n < 10:
        return "0" + n
    return "" + n

def tik():
    detik = detik + 1
    if detik >= 60:
        detik = 0
        menit = menit + 1
    if menit >= 60:
        menit = 0
        jam = jam + 1
    set("layar", "text", dua(jam) + ":" + dua(menit) + ":" + dua(detik))

timer every 1 (tik()). jamDetik
forever:
    wait 1
