// request: game tebak ganjil genap lawan komputer || an odd or even guessing game against the computer
background("#004d40")
var skor = 0
on 16 10 draw text "skor 0" 18 color "#ffffff". hud
on 200 100 draw text "?" 60 color "#a7ffeb". angka
on 60 240 draw rect 160 44 color "#00796b". ganjil
on 108 252 draw text "GANJIL" 18 color "#ffffff". l1
on 300 240 draw rect 160 44 color "#00796b". genap
on 352 252 draw text "GENAP" 18 color "#ffffff". l2

def cek(tebakan):
    var n = randint(1, 20)
    set("angka", "text", str(n))
    if n % 2 == tebakan:
        skor = skor + 1
    else:
        skor = skor - 1
    set("hud", "text", "skor " + skor)

onclick /id"ganjil" check:
    cek(1)
onclick /id"genap" check:
    cek(0)
