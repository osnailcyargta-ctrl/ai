// request: bertahan dari gelombang zombie, tembak pake spasi || survive waves of zombies, shoot with space
background("#1a2410")
var gelombang = 1
var arahX = 1
var tembak = 0
var pvx = 0
var nyawa = 3
on 250 170 draw square 24 color "#00bcd4". pemain
on -20 -20 draw circle 8 color "#ffff00". peluru
on 0 30 draw square 24 color "#6b8e23". z1
on 500 300 draw square 24 color "#6b8e23". z2
on 16 10 draw text "gelombang 1 · nyawa 3" 16 color "#ffffff". hud

def kejar(id, v):
    if get(id, "x") < get("pemain", "x"):
        move(id, v, 0)
    else:
        move(id, 0 - v, 0)
    if get(id, "y") < get("pemain", "y"):
        move(id, 0, v)
    else:
        move(id, 0, 0 - v)
    if touching("peluru", id):
        tembak = 0
        setpos("peluru", -20, -20)
        setpos(id, choose(-30, 530), randint(30, 330))
        gelombang = gelombang + 0.2
    if touching("pemain", id):
        nyawa = nyawa - 1
        setpos(id, choose(-30, 530), randint(30, 330))
        if nyawa <= 0:
            show.popup("dimakan zombie di gelombang " + floor(gelombang))
            nyawa = 3
            gelombang = 1
    set("hud", "text", "gelombang " + floor(gelombang) + " · nyawa " + nyawa)

forever:
    if key("left"):
        move("pemain", -3, 0)
        arahX = -1
    if key("right"):
        move("pemain", 3, 0)
        arahX = 1
    if key("up"):
        move("pemain", 0, -3)
    if key("down"):
        move("pemain", 0, 3)
    if key("space") and tembak == 0:
        tembak = 1
        pvx = arahX * 9
        setpos("peluru", get("pemain", "x") + 8, get("pemain", "y") + 8)
    if tembak == 1:
        move("peluru", pvx, 0)
        if get("peluru", "x") < -10 or get("peluru", "x") > 530:
            tembak = 0
    kejar("z1", 0.8 + gelombang * 0.2)
    kejar("z2", 0.6 + gelombang * 0.2)
