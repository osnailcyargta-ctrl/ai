// request: alarm yang bunyi setelah beberapa detik || an alarm that goes off after some seconds
background("#263238")
on 16 20 draw text "alarm" 26 color "#ffab40". judul
on 16 80 draw text "" 40 color "#ffffff". sisa
var d = num(show.anspopup("alarm berapa detik lagi?"))
if d < 1:
    d = 5
def bunyi():
    set("judul", "text", "BANGUN WOI")
    show.popup("BANGUN WOI ⏰")

countdown {d} (bunyi()). alarm
forever:
    set("sisa", "text", str(ceil(/time"alarm")) + " detik")
