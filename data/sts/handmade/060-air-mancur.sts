// request: air mancur partikel || a particle fountain
background("#102030")
on 230 330 draw rect 60 30 color "#607d8b". kolam
on 0 0 draw circle 8 color "#4fc3f7". p1
on 0 0 draw circle 8 color "#81d4fa". p2
on 0 0 draw circle 8 color "#29b6f6". p3
on 0 0 draw circle 8 color "#b3e5fc". p4
var t1 = 0
var t2 = 20
var t3 = 40
var t4 = 60

def tetes(id, t, arah):
    var x = 256 + arah * t * 1.2
    var y = 330 - t * 6 + t * t * 0.09
    setpos(id, x, y)
    if t > 66:
        return 0
    return t + 1

forever:
    t1 = tetes("p1", t1, 1)
    t2 = tetes("p2", t2, -1)
    t3 = tetes("p3", t3, 0.5)
    t4 = tetes("p4", t4, -0.5)
