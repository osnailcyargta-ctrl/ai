// request: lindungin kota dari meteor pake perisai yang digerakin mouse || protect the city from meteors with a shield moved by the mouse
background("#0a0e27")
var kota = 5
var skor = 0
on 0 330 draw rect 520 30 color "#455a64". kotaGambar
on 200 290 draw rect 110 10 color "#00e5ff". perisai
on 100 -30 draw circle 22 color "#ff6d00". m1
on 350 -150 draw circle 18 color "#ff6d00". m2
on 16 10 draw text "kota 5 · skor 0" 16 color "#ffffff". hud

def jatuh(id, v):
    move(id, 0, v)
    if touching(id, "perisai"):
        skor = skor + 1
        setpos(id, randint(10, 490), -40)
    if get(id, "y") > 320:
        kota = kota - 1
        setpos(id, randint(10, 490), -40)
        if kota <= 0:
            show.popup("kota ancur. skor " + skor)
            kota = 5
            skor = 0
    set("hud", "text", "kota " + kota + " · skor " + skor)

forever:
    set("perisai", "x", mousex() - 55)
    jatuh("m1", 2.5 + skor / 20)
    jatuh("m2", 3 + skor / 20)
