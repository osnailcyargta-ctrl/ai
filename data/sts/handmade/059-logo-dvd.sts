// request: logo dvd mantul mantul ganti warna tiap kena pinggir || a bouncing dvd logo that changes colour on every edge
background("#000000")
var vx = 2.5
var vy = 2
on 100 80 draw rect 90 46 color "#ff0055". logo
on 118 92 draw text "DVD" 22 color "#000000". tulisan

def warna():
    set("logo", "color", choose("#ff0055", "#00e5ff", "#76ff03", "#ffea00", "#d500f9", "#ff9100"))

forever:
    move("logo", vx, vy)
    if get("logo", "x") < 0 or get("logo", "x") > 430:
        vx = 0 - vx
        warna()
    if get("logo", "y") < 0 or get("logo", "y") > 314:
        vy = 0 - vy
        warna()
    setpos("tulisan", get("logo", "x") + 18, get("logo", "y") + 12)
