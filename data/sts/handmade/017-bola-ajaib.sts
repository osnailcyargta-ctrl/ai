// request: bola ajaib 8 yang jawab pertanyaan || a magic 8 ball that answers questions
background("#000000")
on 160 60 draw circle 200 color "#111111". bola
on 215 120 draw circle 90 color "#1a237e". jendela
on 232 158 draw text "8" 30 color "#ffffff". jawaban
on 120 300 draw text "klik bolanya terus tanya" 16 color "#777777". info

onclick /id"bola" check:
    var t = show.anspopup("tanya apa aja:")
    var j = choose("iya", "ga", "mungkin", "tanya lagi nanti", "pasti", "jangan ngarep", "bisa jadi")
    set("jawaban", "text", j)
    show.popup(t + " -> " + j)
