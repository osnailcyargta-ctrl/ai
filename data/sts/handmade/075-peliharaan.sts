// request: peliharaan virtual kayak tamagotchi, kasih makan biar ga laper || a virtual pet like a tamagotchi, feed it so it isn't hungry
background("#fce4ec")
var lapar = 50
var senang = 50
on 200 80 draw circle 120 color "#f48fb1". hewan
on 235 120 draw text "•ᴥ•" 30 color "#4a148c". muka
on 16 10 draw text "" 16 color "#4a148c". hud
on 60 270 draw rect 150 40 color "#ec407a". makan
on 100 281 draw text "kasih makan" 15 color "#ffffff". l1
on 310 270 draw rect 150 40 color "#ab47bc". main
on 360 281 draw text "ajak main" 15 color "#ffffff". l2

def tulis():
    set("hud", "text", "lapar " + lapar + " · senang " + senang)
    if lapar > 80 or senang < 20:
        set("muka", "text", "T_T")
    else:
        set("muka", "text", "•ᴥ•")

def waktu():
    lapar = min(100, lapar + 3)
    senang = max(0, senang - 2)
    tulis()

timer every 1 (waktu()). jam

onclick /id"makan" check:
    lapar = max(0, lapar - 20)
    tulis()
onclick /id"main" check:
    senang = min(100, senang + 15)
    lapar = min(100, lapar + 5)
    tulis()
tulis()
