// request: tampilin tabel perkalian || show a multiplication table
background("#102027")
on 16 10 draw text "tabel perkalian" 22 color "#4fc3f7". judul
var n = num(show.anspopup("perkalian berapa?"))
var i = 1
while i <= 10:
    if i == 1:
        on 16 50 draw text "" 18 color "#ffffff". b1
    i = i + 1
var teks = ""
on 16 60 draw text "" 17 color "#ffffff". baris1
on 16 85 draw text "" 17 color "#ffffff". baris2
on 16 110 draw text "" 17 color "#ffffff". baris3
on 16 135 draw text "" 17 color "#ffffff". baris4
on 16 160 draw text "" 17 color "#ffffff". baris5
on 260 60 draw text "" 17 color "#ffffff". baris6
on 260 85 draw text "" 17 color "#ffffff". baris7
on 260 110 draw text "" 17 color "#ffffff". baris8
on 260 135 draw text "" 17 color "#ffffff". baris9
on 260 160 draw text "" 17 color "#ffffff". baris10
i = 1
while i <= 10:
    set("baris" + i, "text", n + " x " + i + " = " + (n * i))
    i = i + 1
