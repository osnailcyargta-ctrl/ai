// request: game ranjau 3x3, satu kotak isinya bom || a 3x3 minefield: one cell hides a bomb
background("#212121")
var bom = randint(1, 9)
var aman = 0
var mati = 0
on 16 10 draw text "buka 8 kotak aman" 16 color "#ffffff". hud

def kotak(n):
    if mati == 1:
        return
    if n == bom:
        mati = 1
        set("k" + n, "color", "#d50000")
        show.popup("BOOM. kebuka " + aman + " kotak")
    elif get("k" + n, "color") != "#4caf50":
        aman = aman + 1
        set("k" + n, "color", "#4caf50")
        if aman == 8:
            show.popup("selamat! semua aman")

on 140 60 draw square 76 color "#616161". k1
on 222 60 draw square 76 color "#616161". k2
on 304 60 draw square 76 color "#616161". k3
on 140 142 draw square 76 color "#616161". k4
on 222 142 draw square 76 color "#616161". k5
on 304 142 draw square 76 color "#616161". k6
on 140 224 draw square 76 color "#616161". k7
on 222 224 draw square 76 color "#616161". k8
on 304 224 draw square 76 color "#616161". k9
onclick /id"k1" check:
    kotak(1)
onclick /id"k2" check:
    kotak(2)
onclick /id"k3" check:
    kotak(3)
onclick /id"k4" check:
    kotak(4)
onclick /id"k5" check:
    kotak(5)
onclick /id"k6" check:
    kotak(6)
onclick /id"k7" check:
    kotak(7)
onclick /id"k8" check:
    kotak(8)
onclick /id"k9" check:
    kotak(9)
