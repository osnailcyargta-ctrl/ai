// request: game mancing, turunin kail pake spasi buat nangkep ikan || a fishing game: drop the hook with space to catch fish
background("#0277bd")
var turun = 0
var dapet = 0
on 0 0 draw rect 520 50 color "#81d4fa". langit
on 250 50 draw line 250 60 color "#ffffff". tali
on 244 60 draw square 12 color "#cfd8dc". kail
on 0 200 draw ellipse 40 18 color "#ff8f00". ikan1
on 300 280 draw ellipse 50 22 color "#ffd54f". ikan2
on 16 10 draw text "dapet 0" 16 color "#01579b". hud

def renang(id, v):
    move(id, v, 0)
    if get(id, "x") > 530:
        set(id, "x", -50)
    if turun != 0 and touching("kail", id):
        dapet = dapet + 1
        set("hud", "text", "dapet " + dapet)
        setpos(id, -60, randint(120, 320))
        turun = -1

forever:
    if key("space") and turun == 0:
        turun = 1
    if turun == 1:
        move("kail", 0, 4)
        if get("kail", "y") > 330:
            turun = -1
    if turun == -1:
        move("kail", 0, -5)
        if get("kail", "y") <= 60:
            set("kail", "y", 60)
            turun = 0
    set("tali", "h", get("kail", "y"))
    renang("ikan1", 2)
    renang("ikan2", 1.3)
