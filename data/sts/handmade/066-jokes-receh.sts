// request: generator jokes receh || a cheesy joke generator
background("#1a237e")
on 16 20 draw text "jokes receh" 22 color "#ffeb3b". judul
on 16 100 draw text "" 17 color "#ffffff". tanya
on 16 150 draw text "" 17 color "#80deea". jawab
on 16 280 draw rect 140 40 color "#3949ab". tombol
on 40 290 draw text "jokes lagi" 18 color "#ffffff". lt
var n = 0

onclick /id"tombol" check:
    n = randint(1, 4)
    set("jawab", "text", "")
    if n == 1:
        set("tanya", "text", "ikan apa yang bisa terbang?")
        set("jawab", "text", "lelelawar")
    elif n == 2:
        set("tanya", "text", "sayur apa yang dingin?")
        set("jawab", "text", "kembang kol")
    elif n == 3:
        set("tanya", "text", "hewan apa yang paling kaya?")
        set("jawab", "text", "beruang")
    else:
        set("tanya", "text", "kenapa matahari ga sekolah?")
        set("jawab", "text", "udah pinter, kan bintang")
