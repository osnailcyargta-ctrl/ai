// request: animasi bintang terbang kayak warp speed || a warp speed starfield animation
background("#000000")
var t = 0
on 0 0 draw square 3 color "#ffffff". b1
on 0 0 draw square 3 color "#ffffff". b2
on 0 0 draw square 3 color "#ffffff". b3
on 0 0 draw square 3 color "#ffffff". b4
on 0 0 draw square 3 color "#ffffff". b5
on 0 0 draw square 3 color "#ffffff". b6

def terbang(id, sudut, jarak):
    var r = (t * 4 + jarak) % 300
    setpos(id, 260 + cos(sudut) * r, 180 + sin(sudut) * r)
    set(id, "w", 1 + r / 60)
    set(id, "h", 1 + r / 60)

forever:
    t = t + 1
    terbang("b1", 0.3, 0)
    terbang("b2", 1.4, 50)
    terbang("b3", 2.5, 100)
    terbang("b4", 3.6, 150)
    terbang("b5", 4.7, 200)
    terbang("b6", 5.8, 250)
