// request: animasi daun ketiup angin || an animation of leaves blown by the wind
background("#e8f5e9")
var angin = 1
on 0 0 draw ellipse 22 12 color "#43a047". d1
on 0 0 draw ellipse 18 10 color "#ef6c00". d2
on 0 0 draw ellipse 20 11 color "#c0ca33". d3
setpos("d1", 40, 60)
setpos("d2", 160, 150)
setpos("d3", 300, 40)

def terbang(id, f):
    move(id, angin * 2 + sin(get(id, "y") / 15 + f), 0.8 + cos(get(id, "x") / 20))
    set(id, "rot", get(id, "x") * 3)
    if get(id, "x") > 530 or get(id, "y") > 370:
        setpos(id, -20, randint(0, 200))

timer every 3 (angin = rand(0.3, 2.5)). tiupan
forever:
    terbang("d1", 0)
    terbang("d2", 2)
    terbang("d3", 4)
