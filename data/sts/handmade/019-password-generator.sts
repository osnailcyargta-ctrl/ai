// request: bikin password random yang kuat || generate a strong random password
background("#0b0f0b")
on 16 20 draw text "password generator" 22 color "#00ff88". judul
on 16 110 draw text "" 30 color "#ffffff". hasil
on 16 220 draw rect 180 40 color "#006633". tombol
on 40 230 draw text "bikin baru" 18 color "#ffffff". lt

def huruf():
    return choose(choose("a", "b", "c", "d", "e", "f", "g", "h"), choose("k", "m", "n", "p", "r", "s", "t", "x"), choose("z", "A", "B", "K", "R", "X"))

def simbol():
    return choose("!", "@", "#", "$", "%", "&", "?")

def baru():
    var p = huruf() + huruf() + randint(10, 99) + simbol() + huruf() + huruf() + huruf() + randint(0, 9) + simbol()
    set("hasil", "text", p)

onclick /id"tombol" check:
    baru()
baru()
