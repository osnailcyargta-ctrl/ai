// request: blackjack sederhana, ambil kartu sampe mau berhenti || simple blackjack: draw cards until u stop
background("#0b6623")
var total = 0
var bandar = 0
var selesai = 0
on 16 10 draw text "blackjack" 24 color "#ffffff". judul
on 16 60 draw text "kartu lu: 0" 22 color "#ffffff". hudLu
on 16 100 draw text "" 22 color "#ffeb3b". hudBandar
on 40 200 draw rect 140 44 color "#ffffff". ambil
on 75 212 draw text "AMBIL" 18 color "#0b6623". l1
on 220 200 draw rect 140 44 color "#ffffff". stop
on 260 212 draw text "STOP" 18 color "#0b6623". l2

def akhir():
    selesai = 1
    bandar = randint(15, 23)
    set("hudBandar", "text", "bandar: " + bandar)
    if total > 21:
        show.popup("lewat 21. kalah")
    elif bandar > 21 or total > bandar:
        show.popup("menang!")
    elif total == bandar:
        show.popup("seri")
    else:
        show.popup("kalah")

onclick /id"ambil" check:
    if selesai == 0:
        total = total + randint(1, 11)
        set("hudLu", "text", "kartu lu: " + total)
        if total > 21:
            akhir()
onclick /id"stop" check:
    if selesai == 0:
        akhir()
