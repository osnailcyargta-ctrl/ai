// request: lempar koin kepala atau ekor || flip a coin, heads or tails
background("#1f1a12")
var kepala = 0
var ekor = 0
on 200 70 draw circle 120 color "#d4a017". koin
on 236 115 draw text "?" 40 color "#5a4500". sisi
on 190 230 draw rect 140 40 color "#6b4f12". tombol
on 222 240 draw text "LEMPAR" 18 color "#ffffff". lt
on 16 300 draw text "kepala 0 · ekor 0" 16 color "#cccccc". hitung

onclick /id"tombol" check:
    if chance(0.5):
        kepala = kepala + 1
        set("sisi", "text", "K")
    else:
        ekor = ekor + 1
        set("sisi", "text", "E")
    set("hitung", "text", "kepala " + kepala + " · ekor " + ekor)
