// request: aim trainer, klik target yang makin kecil || an aim trainer: click the targets as they shrink
background("#101010")
var ukuran = 70
var kena = 0
on 220 150 draw circle 70 color "#ff3b3b". target
on 16 10 draw text "kena 0" 16 color "#ffffff". hud

onclick /id"target" check:
    kena = kena + 1
    ukuran = max(14, ukuran - 4)
    set("target", "w", ukuran)
    set("target", "h", ukuran)
    setpos("target", randint(10, 500 - ukuran), randint(40, 350 - ukuran))
    set("hud", "text", "kena " + kena)
