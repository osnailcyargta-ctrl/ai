// request: cookie clicker ada upgrade auto klik || a cookie clicker with an auto clicker upgrade
background("#3e2723")
var kue = 0
var auto = 0
var harga = 15
on 160 60 draw circle 180 color "#d7a86e". kueBesar
on 16 10 draw text "kue: 0" 22 color "#ffffff". hud
on 16 40 draw text "auto: 0/detik" 14 color "#bcaaa4". hudAuto
on 340 300 draw rect 170 44 color "#6d4c41". tombolUpgrade
on 350 312 draw text "auto klik (15)" 16 color "#ffffff". lu

def tulis():
    set("hud", "text", "kue: " + floor(kue))
    set("hudAuto", "text", "auto: " + auto + "/detik")
    set("lu", "text", "auto klik (" + harga + ")")

onclick /id"kueBesar" check:
    kue = kue + 1
    tulis()

onclick /id"tombolUpgrade" check:
    if kue >= harga:
        kue = kue - harga
        auto = auto + 1
        harga = floor(harga * 1.5)
        tulis()

timer every 1 (kue = kue + auto; tulis()). pabrik
forever:
    wait 1
