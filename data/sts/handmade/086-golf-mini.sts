// request: golf mini, klik buat mukul bola ke lubang || mini golf: click to hit the ball into the hole
background("#43a047")
var vx = 0
var vy = 0
var pukulan = 0
on 420 160 draw circle 26 color "#1b1b1b". lubang
on 60 170 draw circle 16 color "#ffffff". bola
on 220 100 draw rect 20 140 color "#795548". tembok
setup coll /id"tembok" solid. dinding
on 16 10 draw text "klik arah buat mukul · pukulan 0" 14 color "#ffffff". hud

forever:
    if mousedown() and abs(vx) + abs(vy) < 0.2:
        vx = (mousex() - get("bola", "x")) / 25
        vy = (mousey() - get("bola", "y")) / 25
        pukulan = pukulan + 1
        set("hud", "text", "klik arah buat mukul · pukulan " + pukulan)
    move("bola", vx, vy)
    vx = vx * 0.97
    vy = vy * 0.97
    if get("bola", "x") < 0 or get("bola", "x") > 504:
        vx = 0 - vx
    if get("bola", "y") < 30 or get("bola", "y") > 344:
        vy = 0 - vy
    if touching("bola", "lubang") and abs(vx) + abs(vy) < 3:
        show.popup("masuk dalam " + pukulan + " pukulan!")
        pukulan = 0
        vx = 0
        vy = 0
        setpos("bola", 60, 170)
