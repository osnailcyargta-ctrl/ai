// request: kumpulin koin sebanyak mungkin sebelum waktu abis, ada musuh || collect as many coins as u can before time runs out, with an enemy
background("#212121")
var koin = 0
var nyawa = 3
on 40 170 draw square 24 color "#29b6f6". pemain
on 300 100 draw circle 18 color "#ffd600". koin1
on 420 260 draw circle 18 color "#ffd600". koin2
on 480 40 draw square 26 color "#e53935". musuh
on 16 10 draw text "koin 0 · nyawa 3" 16 color "#ffffff". hud
on 440 10 draw text "20" 16 color "#ffd600". sisa

def ambil(id):
    if touching("pemain", id):
        koin = koin + 1
        setpos(id, randint(20, 490), randint(40, 330))

def habis():
    show.popup("waktu abis! koin lu " + koin)
    koin = 0
    countdown start. waktu

countdown 20 (habis()). waktu

forever:
    if key("left"):
        move("pemain", -4, 0)
    if key("right"):
        move("pemain", 4, 0)
    if key("up"):
        move("pemain", 0, -4)
    if key("down"):
        move("pemain", 0, 4)
    ambil("koin1")
    ambil("koin2")
    move("musuh", (get("pemain", "x") - get("musuh", "x")) * 0.01, (get("pemain", "y") - get("musuh", "y")) * 0.01)
    if touching("pemain", "musuh"):
        nyawa = nyawa - 1
        setpos("musuh", 480, 40)
        if nyawa <= 0:
            show.popup("game over. koin " + koin)
            nyawa = 3
            koin = 0
    set("hud", "text", "koin " + koin + " · nyawa " + nyawa)
    set("sisa", "text", str(ceil(/time"waktu")))
