// request: timer pomodoro 25 menit || a 25 minute pomodoro timer
background("#2b1a1a")
var sisa = 1500
on 110 60 draw text "fokus dulu" 24 color "#ffb3a7". judul
on 130 120 draw text "25:00" 72 color "#ffffff". layar
on 60 260 draw rect 400 16 color "#4a2f2f". jalurBar
on 60 260 draw rect 400 16 color "#ff6f59". bar

def tulis():
    var m = floor(sisa / 60)
    var d = sisa % 60
    var ds = "" + d
    if d < 10:
        ds = "0" + d
    set("layar", "text", m + ":" + ds)
    set("bar", "w", 400 * sisa / 1500)

def kurang():
    if sisa > 0:
        sisa = sisa - 1
        tulis()
    if sisa == 0:
        set("judul", "text", "istirahat!")

timer every 1 (kurang()). jamFokus
forever:
    wait 1
