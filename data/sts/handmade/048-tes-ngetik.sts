// request: tes ngetik, ketik ulang kata yang muncul || a typing test: retype the word that appears
background("#202124")
var benar = 0
var ronde = 0
on 16 10 draw text "benar 0/0" 18 color "#ffffff". hud
while ronde < 5:
    var kata = choose("kucing", "pelangi", "sepeda", "matahari", "jendela", "kopi", "komputer", "naga")
    var t = show.anspopup("ketik: " + kata)
    ronde = ronde + 1
    if t == kata:
        benar = benar + 1
    set("hud", "text", "benar " + benar + "/" + ronde)
show.popup("hasil: " + benar + " dari 5")
