// request: tarik tambang 2 pemain || tug of war for 2 players
background("#33691e")
var posisi = 0
var t1 = 0
var t2 = 0
on 255 0 draw rect 10 360 color "#ffffff". tengah
on 60 175 draw rect 400 10 color "#8d6e63". tali
on 255 165 draw square 30 color "#d50000". bendera
on 16 10 draw text "kiri: A berkali kali · kanan: L berkali kali" 14 color "#ffffff". info

forever:
    if key("a") and t1 == 0:
        posisi = posisi - 6
        t1 = 1
    if not key("a"):
        t1 = 0
    if key("l") and t2 == 0:
        posisi = posisi + 6
        t2 = 1
    if not key("l"):
        t2 = 0
    set("tali", "x", 60 + posisi)
    set("bendera", "x", 255 + posisi)
    if posisi < -180:
        show.popup("tim kiri menang!")
        posisi = 0
    if posisi > 180:
        show.popup("tim kanan menang!")
        posisi = 0
