// request: pacman mini, makan titik dikejar 1 hantu || mini pacman: eat the dots while a ghost chases u
background("#000000")
var titik = 6
on 40 170 draw circle 24 color "#ffeb3b". pac
on 440 40 draw square 24 color "#ff1744". hantu
on 120 80 draw circle 8 color "#ffffff". d1
on 250 80 draw circle 8 color "#ffffff". d2
on 380 80 draw circle 8 color "#ffffff". d3
on 120 260 draw circle 8 color "#ffffff". d4
on 250 260 draw circle 8 color "#ffffff". d5
on 380 260 draw circle 8 color "#ffffff". d6

def makan(id):
    if exists(id) and touching("pac", id):
        destroy(id)
        titik = titik - 1
        if titik == 0:
            show.popup("semua titik abis. menang!")

forever:
    if key("left"):
        move("pac", -3, 0)
    if key("right"):
        move("pac", 3, 0)
    if key("up"):
        move("pac", 0, -3)
    if key("down"):
        move("pac", 0, 3)
    if get("hantu", "x") < get("pac", "x"):
        move("hantu", 1.6, 0)
    else:
        move("hantu", -1.6, 0)
    if get("hantu", "y") < get("pac", "y"):
        move("hantu", 0, 1.6)
    else:
        move("hantu", 0, -1.6)
    makan("d1")
    makan("d2")
    makan("d3")
    makan("d4")
    makan("d5")
    makan("d6")
    if touching("pac", "hantu"):
        show.popup("ketangkep hantu")
        setpos("pac", 40, 170)
        setpos("hantu", 440, 40)
