// request: kebun idle, tanaman tumbuh terus dipanen || an idle garden: plants grow and u harvest them
background("#5d4037")
var umur = 0
var koin = 0
on 210 260 draw rect 100 30 color "#3e2723". pot
on 250 240 draw rect 20 20 color "#66bb6a". tanaman
on 16 10 draw text "koin 0" 18 color "#ffd54f". hud
on 16 40 draw text "klik tanaman kalo udah gede" 14 color "#d7ccc8". info

def tumbuh():
    if umur < 10:
        umur = umur + 1
        set("tanaman", "h", 20 + umur * 15)
        set("tanaman", "y", 260 - (20 + umur * 15))
    if umur == 10:
        set("tanaman", "color", "#ffca28")

timer every 0.6 (tumbuh()). jam

onclick /id"tanaman" check:
    if umur == 10:
        koin = koin + 5
        umur = 0
        set("tanaman", "color", "#66bb6a")
        set("tanaman", "h", 20)
        set("tanaman", "y", 240)
        set("hud", "text", "koin " + koin)
forever:
    wait 1
