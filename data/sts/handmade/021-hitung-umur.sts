// request: hitung umur dari tahun lahir || work out someone's age from their birth year
background("#202020")
on 16 20 draw text "berapa umur lu?" 24 color "#ffb703". judul
on 16 100 draw text "" 26 color "#ffffff". hasil
var lahir = num(show.anspopup("tahun lahir lu?"))
var umur = 2026 - lahir
if umur < 0:
    set("hasil", "text", "lu dari masa depan?")
elif umur > 120:
    set("hasil", "text", "ga mungkin bang")
else:
    set("hasil", "text", "umur lu sekitar " + umur + " tahun")
