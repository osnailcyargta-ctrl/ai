// request: animasi detak jantung yang berdenyut || a beating heart animation
background("#1a0006")
var t = 0
on 210 120 draw circle 100 color "#e91e63". jantung
on 210 290 draw text "bpm 72" 20 color "#ff80ab". hud

forever:
    t = t + 1
    var s = 100 + abs(sin(t * 0.08)) * 20
    set("jantung", "w", s)
    set("jantung", "h", s)
    setpos("jantung", 260 - s / 2, 170 - s / 2)
    if t % 60 == 0:
        set("hud", "text", "bpm " + randint(68, 80))
