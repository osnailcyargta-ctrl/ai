// request: balapan 2 pemain adu cepet mencet tombol || a 2 player race: mash your key to win
background("#1e272e")
var p1 = 20
var p2 = 20
var tahan1 = 0
var tahan2 = 0
on 0 0 draw rect 500 360 color "#1e272e". bg
on 480 0 draw rect 6 360 color "#ffffff". finish
on 20 100 draw square 30 color "#ff3f34". mobil1
on 20 220 draw square 30 color "#0fbcf9". mobil2
on 16 10 draw text "pemain 1 mencet Q, pemain 2 mencet P" 14 color "#d2dae2". info

forever:
    if key("q") and tahan1 == 0:
        p1 = p1 + 12
        tahan1 = 1
    if not key("q"):
        tahan1 = 0
    if key("p") and tahan2 == 0:
        p2 = p2 + 12
        tahan2 = 1
    if not key("p"):
        tahan2 = 0
    set("mobil1", "x", p1)
    set("mobil2", "x", p2)
    if p1 >= 450 or p2 >= 450:
        if p1 >= p2:
            show.popup("pemain 1 menang")
        else:
            show.popup("pemain 2 menang")
        p1 = 20
        p2 = 20
