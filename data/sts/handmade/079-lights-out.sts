// request: puzzle lights out, klik lampu buat matiin semuanya || a lights out puzzle: click lamps to turn them all off
background("#101010")
var langkah = 0
on 16 10 draw text "matiin semua lampu" 16 color "#ffffff". hud

def tukar(n):
    if n < 1 or n > 4:
        return
    if get("l" + n, "color") == "#ffd600":
        set("l" + n, "color", "#333333")
    else:
        set("l" + n, "color", "#ffd600")

def cek():
    var semua = get("l1", "color") == "#333333" and get("l2", "color") == "#333333" and get("l3", "color") == "#333333" and get("l4", "color") == "#333333"
    if semua:
        show.popup("beres dalam " + langkah + " langkah")

def klik(n):
    langkah = langkah + 1
    tukar(n)
    tukar(n - 1)
    tukar(n + 1)
    cek()

on 60 140 draw circle 80 color "#ffd600". l1
on 170 140 draw circle 80 color "#333333". l2
on 280 140 draw circle 80 color "#ffd600". l3
on 390 140 draw circle 80 color "#ffd600". l4
onclick /id"l1" check:
    klik(1)
onclick /id"l2" check:
    klik(2)
onclick /id"l3" check:
    klik(3)
onclick /id"l4" check:
    klik(4)
