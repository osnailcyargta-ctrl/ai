// request: tes refleks, klik pas kotaknya jadi ijo || a reaction test: click when the box turns green
background("#1a1a1a")
var siap = 0
var mulai = 0
var hasil = 0
on 130 40 draw text "tunggu ijo, terus klik" 20 color "#cccccc". info
on 160 100 draw square 200 color "#aa2222". kotak
on 150 320 draw text "" 18 color "#ffffff". skor

def nyala():
    siap = 1
    mulai = time()
    set("kotak", "color", "#22aa44")

countdown 2 (nyala()). jeda

onclick /id"kotak" check:
    if siap == 1:
        hasil = round((time() - mulai) * 1000)
        set("skor", "text", "refleks lu: " + hasil + " ms")
        siap = 0
        set("kotak", "color", "#aa2222")
        countdown start. jeda
    else:
        set("skor", "text", "kecepetan! tunggu ijo dulu")
forever:
    wait 1
