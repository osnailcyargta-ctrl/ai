// request: animasi hujan turun || a rain animation
background("#1b2433")
on 0 330 draw rect 520 30 color "#2c3b2a". tanah
on 0 -20 draw rect 2 14 color "#9cc9ff". tetes1
on 0 -20 draw rect 2 14 color "#9cc9ff". tetes2
on 0 -20 draw rect 2 14 color "#9cc9ff". tetes3
on 0 -20 draw rect 2 14 color "#9cc9ff". tetes4
on 0 -20 draw rect 2 14 color "#9cc9ff". tetes5
on 0 -20 draw rect 2 14 color "#9cc9ff". tetes6

def jatuh(id, cepat):
    move(id, -0.6, cepat)
    if get(id, "y") > 330:
        setpos(id, randint(0, 540), randint(-80, -10))

forever:
    jatuh("tetes1", 7)
    jatuh("tetes2", 9)
    jatuh("tetes3", 6)
    jatuh("tetes4", 8)
    jatuh("tetes5", 10)
    jatuh("tetes6", 7.5)
